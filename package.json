{
  "name": "@unit-finance/unit-node-sdk",
  "version": "1.4.3",
  "description": "",
  "main": "dist/unit.js",
  "types": "dist/unit.d.ts",
  "scripts": {
    "test": "jest .spec.ts --maxWorkers=1 --no-cache",
    "test:consumer": "npm run build && mkdir -p pack && npm pack --pack-destination pack --silent && node scripts/verify-consumer.mjs \"pack/$(node -p \"require('./package.json').name.replace('@','').replace('/','-') + '-' + require('./package.json').version + '.tgz'\")\"",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint **/*.ts",
    "lint-fix": "eslint **/*.ts --fix",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unit-finance/unit-node-sdk.git"
  },
  "author": "Unit",
  "license": "MPLv2",
  "bugs": {
    "url": "https://github.com/unit-finance/unit-node-sdk/issues"
  },
  "homepage": "https://github.com/unit-finance/unit-node-sdk#readme",
  "engines": {
    "node": ">=16"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "dotenv": "^10.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^4.2.4"
  },
  "dependencies": {
    "axios": "^1.8.4"
  }
}
